# Runtime identity and binding
NODE_ENV=production
RELEASE_ID=
RELEASE_COMMIT=
RELEASE_TREE=
RELEASE_ARTIFACT_SHA256=
BASE_PATH=/prd-studio
AUTH_MODE=trusted_proxy
SOCKET_PATH=
HOST=127.0.0.1
PORT=8080
TEAM_TOKEN=
WRITE_FENCE_FILE=/var/lib/prd-studio/deployment-control/write-fence

# Runtime database credentials
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SOCKET_PATH=
DB_USER=
DB_PASSWORD=
DB_PASSWORD_FILE=
DB_NAME=
DB_SSL_MODE=disabled
DB_SSL_CA_FILE=

# One-time schema migration credentials (not used by the server)
MIGRATION_DB_HOST=127.0.0.1
MIGRATION_DB_PORT=3306
MIGRATION_DB_SOCKET_PATH=
MIGRATION_DB_USER=
MIGRATION_DB_PASSWORD=
MIGRATION_DB_PASSWORD_FILE=
MIGRATION_DB_NAME=
MIGRATION_DB_SSL_MODE=disabled
MIGRATION_DB_SSL_CA_FILE=
